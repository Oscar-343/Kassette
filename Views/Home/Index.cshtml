@model TreeNode<LibraryItem>
@{ var songs = Model.Songs(); }
<h1>Todas las canciones</h1>
<p class="dim">@Model.CountWhere(i => i.Kind == ItemKind.Artist) artistas · @Model.CountWhere(i => i.Kind == ItemKind.Album) álbumes · @songs.Length canciones</p>
@if (songs.Length > 0) { <p><button class="btn main" data-playall="@string.Join(",", songs.Select(s => s.Id))">▶ Reproducir todo</button></p> }
<partial name="_SongTable" model="songs" />
