@model TreeNode<LibraryItem>
<h1>@Model.Value.Name</h1>
<p class="dim">@Model.CountWhere(i => i.Kind == ItemKind.Song) canciones · @LibraryExtensions.Fmt(Model.Sum(i => i.Song?.Duration ?? 0))</p>
@foreach (var al in Model.Children()) {
  <section class="block"><h2><a data-nav href="@Url.Action("Album", "Home", new { artist = Model.Value.Name, name = al.Value.Name })">@al.Value.Name</a></h2>
  <partial name="_SongTable" model="al.Songs()" /></section>
}
